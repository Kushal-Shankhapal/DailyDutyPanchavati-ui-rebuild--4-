{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["db/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs", "vitest.config.ts"]
}
